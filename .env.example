# Copy to .env for local collection. Never commit the real file.
# A collector runs only when its variables are present. Without them,
# that platform stays "Not connected" and previous numbers are kept.

# YouTube Data API v3 — lifetime channel views and subscriber counts.
# Also reads likes/comments on the latest public videos (stored separately,
# not added to the likes column). Set YOUTUBE_RECENT_ENGAGEMENT=0 to skip that.
YOUTUBE_API_KEY=
YOUTUBE_RECENT_ENGAGEMENT=

# Instagram Graph API Business Discovery. Both values are required.
# The token must be allowed to read the business account named below,
# and that account must be able to discover the configured public handles.
IG_BUSINESS_ACCOUNT_ID=
IG_ACCESS_TOKEN=

# X API v2 app-only bearer token. Reads followers from user public_metrics.
# Like, reply, and impression sums are recorded only when the timeline is
# fully read and every post includes that field. impression_count often
# needs a higher X API access level; followers are still saved without it.
X_BEARER_TOKEN=

# TikTok has no free official API for other people's accounts.
# TIKTOK_PUBLIC=1 reads the public profile (followers, total likes) and the
# public embed (play counts on the videos it returns).
TIKTOK_PUBLIC=

# Optional Apify fallback/alternative for TikTok. Default actor:
# clockworks/tiktok-scraper. Override if you use a different actor.
APIFY_TOKEN=
APIFY_TIKTOK_ACTOR=

# Persist snapshots on Vercel. Without this, cron cannot store new snapshots
# (the serverless filesystem is read-only) and the site keeps data/snapshot.json.
BLOB_READ_WRITE_TOKEN=

# If set, /api/collect requires Authorization: Bearer <CRON_SECRET>
# or an x-cron-secret header. Vercel Cron sends the bearer token automatically
# when this variable exists. Leave unset only for a trusted local server.
CRON_SECRET=

# Optional pause between platform requests, in milliseconds (default 200).
COLLECT_DELAY_MS=
